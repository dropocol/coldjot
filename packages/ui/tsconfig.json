{
    "extends": "@coldjot/tsconfig/library.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "jsx": "react-jsx",
        "lib": ["dom", "dom.iterable", "es2023"],
        "moduleResolution": "bundler",
        "noEmit": true,
        "paths": {
            "@coldjot/ui/*": ["./src/*"]
        }
    },
    "include": ["."],
    "exclude": ["node_modules", "dist"]
}
