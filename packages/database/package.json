{
    "name": "@coldjot/database",
    "version": "0.0.0",
    "private": true,
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "engines": {
        "node": ">=24"
    },
    "files": [
        "dist/**"
    ],
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "build:prod": "tsup",
        "clean": "rm -rf .turbo node_modules dist",
        "db:generate": "prisma generate",
        "db:migrate": "dotenv -e env/.env.development -- prisma migrate dev",
        "db:migrate:create": "dotenv -e env/.env.development -- prisma migrate dev --create-only",
        "db:deploy": "dotenv -e env/.env.development -- prisma migrate deploy",
        "db:push": "dotenv -e env/.env.development -- prisma db push --skip-generate",
        "db:seed": "dotenv -e env/.env.development -- prisma db seed",
        "db:reset": "dotenv -e env/.env.development -- prisma migrate reset --force",
        "db:studio": "dotenv -e env/.env.development -- prisma studio",
        "db:deploy:prod": "dotenv -e env/.env.production -- prisma migrate deploy",
        "db:seed:prod": "dotenv -e env/.env.production -- prisma db seed",
        "db:test:create": "psql ${DATABASE_URL_TEST:-postgresql://postgres:postgres@localhost:5432/coldjot_test} -tc \"SELECT 1 FROM pg_database WHERE datname = 'coldjot_test'\" | grep -q 1 || psql postgresql://postgres:postgres@localhost:5432/postgres -c \"CREATE DATABASE coldjot_test;\"",
        "db:test:deploy": "DATABASE_URL=${DATABASE_URL_TEST:-postgresql://postgres:postgres@localhost:5432/coldjot_test} prisma migrate deploy",
        "db:test:setup": "npm run db:test:create && npm run db:test:deploy",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@coldjot/types": "*",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "pg": "^8.22.0",
        "tsup": "^8.5.1"
    },
    "devDependencies": {
        "@types/node": "^26.1.0",
        "dotenv": "^17.4.2",
        "dotenv-cli": "^11.0.0",
        "prisma": "^7.8.0",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3"
    }
}
