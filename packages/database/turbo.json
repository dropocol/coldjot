{
    "extends": ["//"],
    "tasks": {
        "build": {
            "dependsOn": ["db:generate"],
            "outputs": ["dist/**"]
        },
        "build:dev": {
            "dependsOn": ["db:generate"],
            "outputs": ["dist/**"]
        },
        "build:prod": {
            "dependsOn": ["db:generate"],
            "outputs": ["dist/**"]
        },
        "db:generate": {
            "cache": false,
            "outputs": []
        },
        "db:migrate": { "cache": false },
        "db:migrate:create": { "cache": false },
        "db:deploy": { "cache": false },
        "db:deploy:prod": {
            "cache": false,
            "env": ["DATABASE_URL"]
        },
        "db:push": { "cache": false },
        "db:seed": { "cache": false },
        "db:reset": { "cache": false },
        "db:studio": { "cache": false },
        "db:seed:prod": {
            "cache": false,
            "env": ["DATABASE_URL"]
        }
    }
}
