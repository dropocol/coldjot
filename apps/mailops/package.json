{
    "name": "mailops",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "NODE_OPTIONS='--max-old-space-size=4096' tsx watch src/server.ts",
        "build": "NODE_OPTIONS='--max-old-space-size=4096' tsup",
        "start": "node --expose-gc dist/server.js",
        "build:prod": "tsup",
        "start:prod": "NODE_ENV=production node --expose-gc dist/server.js",
        "dev:debug": "NODE_OPTIONS='--max-old-space-size=4096 --inspect' tsx watch --inspect src/server.ts",
        "lint": "eslint \"src/**/*.ts\"",
        "clean": "rimraf .turbo node_modules dist .tsbuildinfo",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@bull-board/api": "^8.0.2",
        "@bull-board/express": "^8.0.2",
        "@coldjot/database": "*",
        "@coldjot/types": "*",
        "@google-cloud/pubsub": "^5.3.1",
        "@types/jsonwebtoken": "^9.0.8",
        "@types/uuid": "^11.0.0",
        "bullmq": "^5.34.5",
        "cors": "^2.8.5",
        "date-fns": "^4.4.0",
        "dotenv": "^17.4.2",
        "exponential-backoff": "^3.1.1",
        "express": "^5.2.1",
        "googleapis": "^173.0.0",
        "ioredis": "^5.3.2",
        "jsonwebtoken": "^9.0.2",
        "jwks-rsa": "^4.1.0",
        "luxon": "^3.5.0",
        "nanoid": "^5.1.16",
        "openai": "^6.45.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "uuid": "^14.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.13",
        "@types/express": "^5.0.6",
        "@types/luxon": "^3.4.2",
        "@types/node": "^26.1.0",
        "@types/supertest": "^7.2.0",
        "@typescript-eslint/eslint-plugin": "^8.62.1",
        "@typescript-eslint/parser": "^8.62.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.6.0",
        "rimraf": "^6.1.3",
        "supertest": "^7.2.2",
        "tsup": "^8.0.1",
        "tsx": "^4.19.2",
        "typescript": "^6.0.3",
        "vitest": "^2.1.9"
    }
}
