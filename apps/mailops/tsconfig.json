{
    "extends": "@coldjot/tsconfig/app.json",
    "compilerOptions": {
        "lib": ["es2023"],
        "outDir": "./dist",
        "rootDir": "./src",
        "noEmit": true,
        "incremental": false,
        "moduleResolution": "bundler",
        "types": ["node", "vitest/globals"],
        "paths": {
            "@/*": ["./src/*"],
            "@/lib/*": ["./src/lib/*"],
            "@/services/*": ["./src/services/*"],
            "@/routes/*": ["./src/routes/*"],
            "@/types/*": ["./src/types/*"],
            "@/env": ["./src/env.ts"],
            "@/config/*": ["./src/config/*"],
            "@/config": ["./src/config/index.ts"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
