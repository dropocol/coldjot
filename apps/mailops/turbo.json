{
    "extends": ["//"],
    "tasks": {
        "build": {
            "env": [
                "PORT",
                "WEB_APP_URL",
                "MAILOPS_API_URL",
                "TRACK_API_URL",
                "REDIS_*",
                "QUEUE_PREFIX",
                "PUBSUB_*",
                "BYPASS_BUSINESS_HOURS",
                "SERVICE_INTERNAL_TOKEN",
                "GOOGLE_CLIENT_ID_EMAIL",
                "GOOGLE_CLIENT_SECRET_EMAIL",
                "GOOGLE_REDIRECT_URI_EMAIL"
            ],
            "outputs": ["dist/**"]
        },
        "build:prod": {
            "env": [
                "PORT",
                "WEB_APP_URL",
                "MAILOPS_API_URL",
                "TRACK_API_URL",
                "REDIS_*",
                "QUEUE_PREFIX",
                "PUBSUB_*",
                "SERVICE_INTERNAL_TOKEN",
                "GOOGLE_CLIENT_ID_EMAIL",
                "GOOGLE_CLIENT_SECRET_EMAIL",
                "GOOGLE_REDIRECT_URI_EMAIL"
            ],
            "outputs": ["dist/**"]
        }
    }
}
